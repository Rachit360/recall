# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/recall
# Any random string of 32+ characters: `openssl rand -base64 48`
JWT_SECRET=
# From https://console.groq.com — leave empty to run without AI tagging
GROQ_API_KEY=
# Optional: override the model if this one is retired
GROQ_MODEL=llama-3.1-8b-instant
